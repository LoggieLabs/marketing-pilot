{
  "name": "@loggiecid/marketing-page",
  "version": "0.0.1",
  "description": "Loggie marketing landing page - lightweight, no wallet dependencies",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "wrangler pages dev dist --d1 DB=marketing-pilot-intake --local",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "db:init": "node scripts/db-init.mjs",
    "intake:gen-identity": "node scripts/decrypt-intake.mjs --gen-org-identity ./secrets/org.identity.json",
    "intake:dump-latest": "node scripts/decrypt-intake.mjs --dump-latest --db-local --out ./tmp/encrypted.json",
    "intake:decrypt": "node scripts/decrypt-intake.mjs ./secrets/org.identity.json ./tmp/encrypted.json",
    "intake:print-pub": "node scripts/decrypt-intake.mjs --print-pub ./secrets/org.identity.json",
    "test:e2e:intake": "node scripts/test-e2e-intake.mjs",
    "test:unit:normalization": "tsx scripts/test-normalization.mjs"
  },
  "dependencies": {
    "@omnituum/pqc-shared": "0.3.0",
    "@omnituum/secure-intake-client": "git+ssh://git@github.com/Omnituum/secure-intake-client.git#v0.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^5.4.20",
    "wrangler": "^3.0.0"
  }
}
